# Optional primary AI: an OpenAI-compatible endpoint such as LM Studio.
# Leave blank to use Gemini (if configured) or the built-in offline guidance.
LM_STUDIO_URL=
MODEL_NAME=qwen3-vl-30b-a3b-instruct-mlx

# Optional Google Gemini fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local server settings.
PORT=5050
HOST=0.0.0.0
RATE_LIMIT_PER_MIN=50

# Optional persistent browser profile for Career Explorer staff authentication.
# Leave blank/omit to use the local, git-ignored .pathwayu-profile directory.
ENS101_PATHWAYU_PROFILE_DIR=

# Student Readiness Hub (ens101.v1 projection). ENS reads readiness data only from here.
# The consumer token is read from, and must stay in:
#   ~/Library/Application Support/Ensign Student Readiness Hub/consumer-token
# Override that location only if the Hub keeps its data elsewhere:
# READINESS_CONSUMER_TOKEN_PATH=
READINESS_HUB_URL=http://127.0.0.1:5055
